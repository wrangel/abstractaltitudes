.env*
!.env.example
env.production
# Atlas service account for scripts/atlas-ip-sync.sh
env.atlas

# --- Logs ---
# This catches the logs folder and any stray log files in the root
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / IDE Files ---
.DS_Store
.DS_Store?
._*
Thumbs.db
.vscode/
.idea/

# --- Project Specifics ---
material/
# Only ignore .dockerignore if you truly want to manage it differently on every machine
# Usually, .dockerignore IS tracked so the build is consistent.
# .dockerignore 

# --- Scripts ---
# If these contain sensitive production IPs or keys, keep them ignored.
# Otherwise, deployment logic is usually tracked.
scripts/prod-deploy.sh

# Host-specific, and reach the NAS via Synology Drive rather than git — the
# project folder there is a synced copy, not a clone, so ignoring them here
# does not stop them being available where they run.
scripts/ensure-docker-dns.sh

gather_code.js
project_code_dump.md

# Knip report output
knip-report.json
# Database backups made on the NAS (scripts/backup-db.sh); synced via Synology Drive, never committed.
backups/
