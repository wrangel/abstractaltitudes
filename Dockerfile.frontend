# syntax=docker/dockerfile:1
FROM node:23-slim AS build
WORKDIR /app
RUN npm install -g pnpm
COPY package*.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc* ./
RUN --mount=type=cache,target=/root/.pnpm-store \
    pnpm install --frozen-lockfile --ignore-scripts
COPY . .
ARG VITE_API_URL
ARG VITE_MAPBOX_PUBLIC_TOKEN
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_BUNNYCDN_BASE_URL
ARG VITE_GOOGLE_MAPS_MAP_ID
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_MAPBOX_PUBLIC_TOKEN=${VITE_MAPBOX_PUBLIC_TOKEN}
ENV VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}
ENV VITE_GOOGLE_MAPS_MAP_ID=${VITE_GOOGLE_MAPS_MAP_ID}
ENV VITE_BUNNYCDN_BASE_URL=${VITE_BUNNYCDN_BASE_URL}

# Prerendering is mandatory for a production image: the gallery footer links to
# /places/, and the sitemap is generated here. Without this the build would warn
# and ship an image whose "Browse by location" link 404s into the SPA fallback.
#
# The prerender needs an absolute API URL. VITE_API_URL is "/api" in production
# (browser-relative, proxied by nginx), so it is resolved against SITE_ORIGIN;
# override with PRERENDER_API_URL to build against a different host. This means
# the build machine must be able to reach the live API.
# Defaults to 1 but is a build ARG, so an emergency build can opt out without
# editing this file:  REQUIRE_PRERENDER=0 docker compose build
# The backend must be deployed and healthy before the frontend is built —
# the prerender reads its data from the live API.
ARG REQUIRE_PRERENDER=1
ARG SITE_ORIGIN
ARG PRERENDER_API_URL
ENV REQUIRE_PRERENDER=${REQUIRE_PRERENDER}
ENV SITE_ORIGIN=${SITE_ORIGIN}
ENV PRERENDER_API_URL=${PRERENDER_API_URL}

RUN pnpm run frontend:build

FROM nginx:1.28-alpine
RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /app/build /usr/share/nginx/html
# Copy custom nginx main config
COPY nginx/nginx.conf /etc/nginx/nginx.conf
# Copy site config (default.conf)
COPY nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]