// Dependency updates. Replaces .github/dependabot.yml, which cannot run on
// pnpm 11+: Dependabot supports pnpm 7-10, and after the move to pnpm 12 every
// run failed — security updates included — without opening a PR or an issue.
//
// Why a PR at all, rather than `pnpm up` locally: Dockerfile.* and ci.yml
// install with --frozen-lockfile, so pnpm-lock.yaml is the contract for what
// ships. It should change through a reviewed PR that CI has run against.
// Homebrew stays a local chore — see scripts/update-mac.sh.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    // Includes the Dependency Dashboard issue. That is the point of it here:
    // Dependabot failed silently for a week; Renovate lists errors, pending
    // updates and rate-limited PRs in one issue you can glance at.
    "config:recommended",
    // Waits until an npm release is 3 days old. Buys time for a hijacked
    // package to be spotted and unpublished before it lands in the lockfile.
    // Security fixes are exempt and raised as soon as they are known.
    "security:minimumReleaseAgeNpm",
  ],
  timezone: "Europe/Zurich",
  schedule: ["before 6am on monday"],
  prConcurrentLimit: 5,

  // Open no branch or PR until the 3-day release age has passed.
  //
  // Not just tidiness: pnpm 12 has its own supply-chain policy and refuses a
  // frozen-lockfile install containing anything under 24 hours old. With the
  // default prCreation, Renovate opened PRs straight away with a pending
  // stability check, so `test` and `build` failed on ERR_PNPM_MINIMUM_RELEASE_
  // AGE_VIOLATION (#138, #139) and nothing re-ran them afterwards.
  //
  // internalChecksAsSuccess is needed because ci.yml and images.yml run on
  // pull_request, not on pushes to renovate/* branches. Without it the branch
  // has no checks to finish, and "not-pending" can hold the PR back forever.
  //
  // Security PRs skip the 3-day wait but not pnpm's 24 hours: a fix released
  // today goes red until tomorrow. Re-run the failed jobs then.
  prCreation: "not-pending",
  internalChecksFilter: "strict",
  internalChecksAsSuccess: true,

  // Merge when `test` and `build` (required on main) are green. Renovate does
  // the merge itself on its next run rather than through GitHub's auto-merge,
  // which is switched off for this repository. Squash, because main requires
  // linear history. Majors are opted out in packageRules below.
  //
  // Merging publishes :2.1 to Docker Hub (images.yml). Production changes only
  // when prod-deploy.sh runs on the NAS.
  automerge: true,
  automergeType: "pr",
  platformAutomerge: false,
  automergeStrategy: "squash",

  // Security PRs ignore the schedule and prConcurrentLimit above. Two sources:
  // GitHub's Dependabot alerts (covers transitive dependencies, needs the
  // dependency graph to parse pnpm-lock.yaml — see pmOnFail in
  // pnpm-workspace.yaml), and OSV (direct dependencies only, but independent
  // of GitHub, so one failing does not blind both).
  vulnerabilityAlerts: {
    labels: ["security"],
  },
  osvVulnerabilityAlerts: true,

  packageRules: [
    // Minor and patch bundled into two PRs a week — low noise, low risk.
    {
      matchManagers: ["npm"],
      matchDepTypes: ["dependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "production dependencies (minor and patch)",
      commitMessagePrefix: "deps:",
    },
    {
      matchManagers: ["npm"],
      matchDepTypes: ["devDependencies"],
      matchUpdateTypes: ["minor", "patch"],
      groupName: "development dependencies (minor and patch)",
      commitMessagePrefix: "deps-dev:",
    },
    // Majors are deliberately left out of the groups above, so each arrives as
    // its own PR and gets read rather than rubber-stamped — and they are not
    // automerged. `build` compiles, prerenders and checks that pages answer
    // 200, but nothing opens a viewer in a browser. A vite 8→9 or React 19→20,
    // or a marzipano/openseadragon major, is exactly the change that passes
    // that and still breaks panoramas — so `pnpm test` and a look first.
    {
      matchManagers: ["npm"],
      matchUpdateTypes: ["major"],
      commitMessagePrefix: "deps:",
      labels: ["major"],
      automerge: false,
    },
    // pnpm itself, from packageManager in package.json. Always its own PR: the
    // 11→12 move is what changed the lockfile format and broke Dependabot.
    // The Dockerfiles read this field, so bumping it is the only edit needed.
    {
      matchDepTypes: ["packageManager"],
      commitMessagePrefix: "deps-dev:",
    },

    {
      matchManagers: ["github-actions"],
      schedule: ["before 6am on the first day of the month"],
      groupName: "GitHub Actions",
      commitMessagePrefix: "ci:",
    },
    // node and nginx base images in Dockerfile.*. Monthly and grouped; the
    // images workflow builds and smoke-tests them on the PR.
    {
      matchManagers: ["dockerfile"],
      schedule: ["before 6am on the first day of the month"],
      groupName: "Docker base images",
      commitMessagePrefix: "ci:",
    },
    // Our own images in docker-compose.yml. :2.1 is moved by images.yml on
    // every merge; there is nothing for Renovate to propose.
    {
      matchPackageNames: ["wrangel/abstractaltitudes-*"],
      enabled: false,
    },
  ],
}
